# Application metadata
TRACERAG_APP_NAME=TraceRAG
TRACERAG_ENVIRONMENT=development
TRACERAG_VERSION=0.2.1

# Server and logging settings
TRACERAG_HOST=127.0.0.1
TRACERAG_PORT=8000
TRACERAG_LOG_LEVEL=INFO

# OpenAI-compatible API (leave the key empty until configured locally)
TRACERAG_API_KEY=
# TRACERAG_BASE_URL=https://api.openai.com/v1
# TRACERAG_API_PROXY_URL=http://127.0.0.1:7897
TRACERAG_EMBEDDING_MODEL=text-embedding-3-small
TRACERAG_CHAT_MODEL=gpt-4o-mini
TRACERAG_REJECT_THRESHOLD=0.25
# 检索策略可选 vector、bm25、hybrid；旧配置默认继续使用 vector。
TRACERAG_RETRIEVAL_STRATEGY=vector
# BM25按原始分数判断；RRF只用于排序，不作为拒答分数。
TRACERAG_BM25_MIN_SCORE=0
TRACERAG_RRF_K=60

# Local FAISS index location
TRACERAG_INDEX_DIR=indexes/default

# Optional local BGE-M3 embeddings (install with: python -m pip install -e ".[local-embeddings]")
# TRACERAG_EMBEDDING_PROVIDER=local
# TRACERAG_LOCAL_EMBEDDING_PATH=D:/rag/embedding
# Use a separate index when changing embedding models.
# TRACERAG_INDEX_DIR=indexes/bge-m3
# Optional: cpu, cuda, or leave unset for automatic device selection.
# TRACERAG_EMBEDDING_DEVICE=cpu
