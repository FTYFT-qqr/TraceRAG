# 复制为 .env.docker，填写已选 Chat/Embedding 服务；该文件不会提交。
TRACERAG_APP_NAME=TraceRAG
TRACERAG_ENVIRONMENT=container
TRACERAG_VERSION=0.2.1
TRACERAG_LOG_LEVEL=INFO
TRACERAG_API_KEY=
TRACERAG_BASE_URL=https://api.openai.com/v1
TRACERAG_CHAT_MODEL=gpt-4o-mini
TRACERAG_EMBEDDING_PROVIDER=openai
TRACERAG_EMBEDDING_MODEL=text-embedding-3-small
TRACERAG_RETRIEVAL_STRATEGY=hybrid
TRACERAG_REJECT_THRESHOLD=0.25
TRACERAG_BM25_MIN_SCORE=0
TRACERAG_RRF_K=60
# 代理位于宿主机时使用 host.docker.internal，不能使用容器自身的 127.0.0.1。
# TRACERAG_API_PROXY_URL=http://host.docker.internal:7897
